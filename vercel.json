{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/CMO-Handbook", "destination": "/pov/CMO-Handbook", "permanent": true },
    { "source": "/cmo-handbook", "destination": "/pov/CMO-Handbook", "permanent": true }
  ],
  "rewrites": [
    { "source": "/pov/genz-india", "destination": "/pov/genz-india/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
